# Follows a path of base_link poses in the map or the station frame (mowbite_follower). Stops by no longer sending
# commands.

# Kinds of poses, the segment types of the planner
uint8 KIND_PERIMETER=0
uint8 KIND_LANE=1
uint8 KIND_TURN=2
uint8 KIND_TRANSIT=3

# At least 3 poses, none on the position of the one before; each faces the way the mower faces there.
geometry_msgs/Pose[] poses
# One per pose; empty: all KIND_TRANSIT. Turns are driven slower.
uint8[] kinds
# Starts here instead of at poses[0], e.g. to go on after a pause.
uint32 start_index
# Where base_link may be (mowing and navigation areas, plus the margin of the follower): at least one.
geometry_msgs/Polygon[] allowed_areas
# Where base_link must never be.
geometry_msgs/Polygon[] obstacles
# m/s at most on this path, below the limits of the follower and the driver; 0: those limits.
float32 max_speed
# s the mower may stand while the follower drives it, then the path ends as stuck (REASON_TIMEOUT); 0: no such check.
float32 stall_time
# Straight ahead without steering, e.g. out of the docking station, where the wheels sit between guides: the poses
# lie on one line the mower faces at the start (else REASON_INVALID), it neither turns on the spot nor steers back
# onto the line; the path is done once the mower got along it to the last pose.
bool straight
# Backwards, e.g. onto a docking station with the contacts at the back: the poses still face the way the mower faces,
# it moves against that way and steers like forwards.
bool reverse
# m: the path is done once base_link got along the last stretch to this much before the last pose, without turning
# there; 0: once it is within the follower's goal distance of the last pose, then turned to its heading.
float32 end_tolerance
# m base_link may be from the nearest point of the path at most, from the first command on, also before its start and
# past its end; farther off the path ends with REASON_CROSS_TRACK. For a path whose surroundings were checked only that
# far. 0: only the limit of the follower beside the path, which counts once the mower came onto it.
float32 max_cross_track
# The frame of poses and areas. FRAME_MAP: the pose from localization/pose, commands on follower/cmd_vel. FRAME_DOCK:
# the station frame (origin base_link of the docked mower, x the way in), the pose from localization/dock_pose with
# dock_max_position_accuracy plus dock_accuracy_per_m per m from the origin, commands on follower/dock_cmd_vel, which
# mowbite_safety passes as SOURCE_DOCK only.
uint8 FRAME_MAP=0
uint8 FRAME_DOCK=1
uint8 frame
---
uint8 REASON_DONE=0
uint8 REASON_CANCELED=1
uint8 REASON_INVALID=2
# no safety measurement of the platform (hw/capabilities)
uint8 REASON_NOT_ALLOWED=3
uint8 REASON_EMERGENCY=4
uint8 REASON_POSE_LOST=5
uint8 REASON_POSITION_ACCURACY=6
uint8 REASON_HEADING=7
uint8 REASON_CROSS_TRACK=8
uint8 REASON_OUTSIDE=9
# the mower stays behind (stuck) or a phase takes too long
uint8 REASON_TIMEOUT=10
# turning on the spot, base_link got too far from the place the turn began at (wheels that slip, a slope)
uint8 REASON_TURN_SLIDE=11

uint8 reason
string message
# The pose the mower got to; a new goal with this start_index goes on from there.
uint32 index
---
uint32 index
# m, left of the path positive
float32 cross_track
