# latch = true latches the emergency with the reason bits in bits, 0 meaning HIGH_LEVEL; a driver takes HIGH_LEVEL,
# TILT, FENCE, STUCK and UNEXPECTED_RESTART and refuses any other bit. latch = false asks for a release, which takes
# effect once lift, stop and bumper are free; hw/status shows the outcome.
bool latch
uint32 bits
# Why, for the log of the driver.
string reason
---
bool success
string message
# Why a release was refused, empty otherwise: STILL_TILTED, TILT_UNKNOWN, FOREIGN_HOST, DRIVER_MISSING, NO_ANSWER.
string code
# STILL_TILTED: the angle and the release limit in degrees; TILT_UNKNOWN: seconds since the last IMU sample, NaN
# without one. Not used with the other codes.
float32 value
float32 limit
