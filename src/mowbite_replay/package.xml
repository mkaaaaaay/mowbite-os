<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mowbite_replay</name>
  <version>0.0.0</version>
  <description>mowbite_replay: replays the journal of MowBite OS core by core and exports it, without ROS</description>
  <maintainer email="274135729+mkaaaaaay@users.noreply.github.com">mkay</maintainer>
  <license>GPL-3.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>eigen</build_depend>
  <depend>mowbite_journal</depend>
  <depend>mowbite_localization</depend>
  <depend>mowbite_safety</depend>
  <depend>tron_mcu</depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
