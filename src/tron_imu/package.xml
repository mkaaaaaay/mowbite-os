<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tron_imu</name>
  <version>0.0.0</version>
  <description>Reads the WIT JY61P of the Airseekers Tron (ttyS1) and publishes sensor_msgs/Imu</description>
  <maintainer email="274135729+mkaaaaaay@users.noreply.github.com">mkay</maintainer>
  <license>PolyForm-Strict-1.0.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>mowbite_component</build_depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>mowbite_serial</depend>
  <depend>mowbite_watch</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>launch_ros</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>rclpy</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
