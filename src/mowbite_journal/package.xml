<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mowbite_journal</name>
  <version>0.0.0</version>
  <description>Journal of the cores of MowBite OS and their replay, without ROS: every change of a core in the order of its calls</description>
  <maintainer email="274135729+mkaaaaaay@users.noreply.github.com">mkay</maintainer>
  <license>GPL-3.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>pkg-config</buildtool_depend>
  <depend>nlohmann-json-dev</depend>
  <depend>libzstd-dev</depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
