<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mowbite_sim</name>
  <version>0.0.0</version>
  <description>Simulation of MowBite OS on the PC: a simulated Tron (MCU, GNSS, IMU) on ptys</description>
  <maintainer email="274135729+mkaaaaaay@users.noreply.github.com">mkay</maintainer>
  <license>GPL-3.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>mowbite_bringup</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>mowbite_msgs</exec_depend>

  <test_depend>composition_interfaces</test_depend>
  <test_depend>rcl_interfaces</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>mosquitto</test_depend>
  <test_depend>python3-paho-mqtt</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>nav_msgs</test_depend>
  <test_depend>sensor_msgs</test_depend>
  <test_depend>mowbite_msgs</test_depend>
  <test_depend>geometry_msgs</test_depend>
  <test_depend>tron_mcu</test_depend>
  <test_depend>tron_gnss</test_depend>
  <test_depend>tron_imu</test_depend>
  <test_depend>mowbite_localization</test_depend>
  <test_depend>mowbite_bridge</test_depend>
  <test_depend>mowbite_map</test_depend>
  <test_depend>mowbite_follower</test_depend>
  <test_depend>mowbite_ntrip</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
