      "TIMEOUT_INPUTS": 1,
      "STOP": 2,
      "LIFT": 3,
      "LIFT_MULTIPLE": 4,
      "COLLISION": 5,
      "COLLISION_MULTIPLE": 9,
      "TIMEOUT_HIGH_LEVEL": 6,
