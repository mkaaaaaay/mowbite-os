#!/usr/bin/env python3
"""Simulated Airseekers Tron on three ptys: MCU (ttyS9), GNSS (ttyS4) and WIT IMU (ttyS1).

The MCU pty sends sensor, speed, battery, version and motor frames like the real MCU. SpeedData (linear, angular) drives two
wheels: the MCU splits it on --mcu-track, the base turns on the real --track, and the speed frame reports what the wheels
did. The speed drops to 0 --host-timeout seconds (flag host_timeout, 0.2 as measured on the Tron) after the last
SpeedData, also while heartbeats come, and while the lift or stop flag is set; it stays 0 until the next SpeedData. If
the last three SpeedData came each less than 75 ms after the one before, the setpoint lasts --fast-speed-hold s (flag
fast_speed_hold, 3.6 as measured on the Tron at 20 SpeedData/s; 0 off). The motor report gives the drive motors as the Tron does: right before left, negative rpm forwards. Standing wheels report
the noise of the Tron with --standstill-noise (flag standstill_noise). The state file counts the bytes the host wrote to
the MCU pty (host_bytes). The GNSS pty carries NMEA GGA, RMC and VTG for the
antenna position (5 Hz), the IMU pty WIT standard frames 0x51, 0x52, 0x53 (50 Hz) for an upright sensor.
Optional: a JSON file with flags (lift, stop, bumper, bumper_left, bumper_right, rain, dock, host_timeout, fast_speed_hold, gnss_quality, gnss_noise, gnss_age, gnss_delay,
yaw_drift, wheel_deadband, odom_scale, track, imu_off, cutter_ignores_off, cutter_holds, gnss_rtcm, dock_shift_x,
dock_shift_y, dock_hollow_speed, place, tilt_roll, tilt_pitch, gyro_bias_dps, charge_current, battery_percentage, battery_voltage,
battery_temperature, blade_temperature, standstill_noise) is read every 10 ms, every received sub packet goes to a JSON lines log, and --state writes the true pose as JSON; a thread
of its own does all of this file work, so a slow disk never holds the ptys (Files). The
GNSS pty also plays the RTK board in front of the receiver (Board). gnss_rtcm true makes the fix depend on the RTCM the
board passes: RTK fixed with the real age while corrections are at most 120 s old, otherwise single without age.
gnss_noise is the standard deviation (m) of the antenna position, gnss_age the age of the corrections in GGA (s, default
1.0, null leaves the field empty), gnss_delay how old (s) the position is when it is sent, yaw_drift the yaw error (rad)
per metre driven, as omni wheels slip, wheel_deadband the speed (m/s) below which a wheel stands, odom_scale the factor
between the reported and the real wheel speed, track the real track (m). imu_off stops the IMU frames,
cutter_ignores_off keeps the blade turning on off frames, cutter_holds also without any frame from the host. tilt_roll and tilt_pitch (degrees) stand the base on a slope
for the IMU; the wheels and the GNSS do not notice it. gyro_bias_dps overrides --gyro-bias-dps, e.g. a bias that changes
with the temperature. battery_voltage (V, 24.5), battery_temperature and blade_temperature (degC, 30) go into the battery
and the blade motor report.
--dock places a charging station (Dock): the mower stops at it, gets contact there (dock_ok in the battery report) and a
charge current only after the host sent Charge 1: charge_current A (3.0; 0 for a contact that does not charge), none
once battery_percentage (80) reaches 100. Its wheels leave the hollows of the station only at
--dock-hollow-speed or faster. The flag dock forces the contact anywhere; dock_shift_x and dock_shift_y move the station
(m), the mower with it while it has contact; dock_hollow_speed overrides --dock-hollow-speed. place [x, y, yaw_deg]
puts the mower there by hand, once per new value.
"""
import argparse
import atexit
import collections
import datetime
import json
import math
import os
import queue
import random
import select
import signal
import struct
import sys
import termios
import threading
import time
import tty

FRAME_START = 0xA5
FRAME_END = 0x5A
ESCAPE = 0xF5
ESCAPE_CODE = {FRAME_START: 0x01, FRAME_END: 0x02, ESCAPE: 0x03}
ESCAPED_BYTE = {code: raw for raw, code in ESCAPE_CODE.items()}

TO_MCU = 0x00
FROM_MCU = 0x08


def celsius(value):
    """A temperature flag as the signed byte of the MCU."""
    return max(-128, min(127, int(round(float(value)))))


def encode(subpackets):
    """One frame from (type, module, payload) tuples."""
    inner = bytearray([0])
    for packet_type, module, payload in subpackets:
        inner.extend((len(payload), packet_type, module))
        inner.extend(payload)
    inner[0] = len(inner) - 1
    inner.append(sum(inner) % 256)
    out = bytearray([FRAME_START])
    for b in inner:
        out.extend((ESCAPE, ESCAPE_CODE[b]) if b in ESCAPE_CODE else (b,))
    out.append(FRAME_END)
    return bytes(out)


class Decoder:
    """Byte stream to frames. A start byte inside a frame begins a new one."""

    def __init__(self):
        self.inner = None
        self.pending_escape = False

    def feed(self, data):
        for b in data:
            if b == FRAME_START:
                self.inner = bytearray()
                self.pending_escape = False
            elif self.inner is None:
                continue
            elif b == FRAME_END:
                yield self._split(self.inner)
                self.inner = None
            elif self.pending_escape:
                self.inner.append(ESCAPED_BYTE.get(b, b))
                self.pending_escape = False
            elif b == ESCAPE:
                self.pending_escape = True
            else:
                self.inner.append(b)

    @staticmethod
    def _split(inner):
        """List of (type, module, payload), or None for a broken frame."""
        if len(inner) < 2 or inner[0] != len(inner) - 2 or sum(inner[:-1]) % 256 != inner[-1]:
            return None
        packets = []
        body = inner[1:-1]
        while body:
            size = body[0]
            if len(body) < 3 + size:
                return None
            packets.append((body[1], body[2], bytes(body[3:3 + size])))
            body = body[3 + size:]
        return packets


def read_flags(path):
    if not path:
        return {}
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


FILES_PERIOD = 0.01
FILES_QUEUE = 100000


class Files:
    """Reads the flags and writes the log and the state on a thread of its own: a slow disk (up to 3.3 s under load)
    must not hold the loop that serves the ptys. The loop takes the flags last read, queues what it writes and hands over
    its newest state, both already serialised; what does not fit the queue is dropped and counted."""

    def __init__(self, flags_path, state_path):
        self.flags_path = flags_path
        self.state_path = state_path
        self.flags = read_flags(flags_path)
        self.dropped = self.errors = 0
        self._queue = queue.Queue(FILES_QUEUE)
        self._state = None
        self._closing = threading.Event()
        self._thread = threading.Thread(target=self._run, name="files", daemon=True)
        self._thread.start()

    def write(self, file, data):
        try:
            self._queue.put_nowait((file, data))
        except queue.Full:
            self.dropped += 1

    def state(self, text):
        self._state = text

    def close(self, timeout=2.0):
        """Writes what is still queued, for at most timeout s, and tells what got lost."""
        self._closing.set()
        self._thread.join(timeout)
        if self.dropped or self.errors or self._thread.is_alive():
            print(f"fake_tron: file work lost {self.dropped} queued writes, {self.errors} failed, "
                  f"{'still busy' if self._thread.is_alive() else 'done'} at the end", file=sys.stderr, flush=True)

    def _run(self):
        written_state = None
        while True:
            closing = self._closing.is_set()
            self.flags = read_flags(self.flags_path)
            end = time.monotonic() + FILES_PERIOD
            touched = set()
            while True:
                try:
                    file, data = self._queue.get(timeout=max(0.0, end - time.monotonic()))
                except queue.Empty:
                    break
                try:
                    file.write(data)
                    touched.add(file)
                except OSError:
                    self.errors += 1
                if time.monotonic() >= end:
                    break
            for file in touched:
                try:
                    file.flush()
                except OSError:
                    self.errors += 1
            state = self._state
            if state is not None and state is not written_state and self.state_path:
                written_state = state
                try:
                    write_state(self.state_path, state)
                except OSError:
                    self.errors += 1
            if closing and self._queue.empty():
                return


class Log:
    """JSON lines through Files, stops writing at max_bytes."""

    def __init__(self, path, max_bytes, files):
        self.file = open(path, "w") if path else None
        self.left = max_bytes
        self.files = files

    def write(self, entry):
        if not self.file or self.left <= 0:
            return
        line = json.dumps(entry) + "\n"
        self.left -= len(line)
        self.files.write(self.file, line)


WGS84_A = 6378137.0
WGS84_E2 = 6.69437999014e-3
KNOTS = 0.514444
SENSOR_PERIOD = 0.02
GNSS_PERIOD = 0.2
IMU_PERIOD = 0.02


class Pose:
    """Base frame in the local ENU frame: x east, y north, yaw counterclockwise from east. Unicycle model."""

    def __init__(self, x=0.0, y=0.0, yaw=0.0):
        self.x, self.y, self.yaw = x, y, yaw
        self.linear = self.angular = self.slip = 0.0

    def step(self, dt, linear, angular, drift=0.0):
        """Advances by dt; drift (rad per m driven) turns the base on top of the commanded rate."""
        self.linear, self.angular = linear, angular
        self.slip = drift * linear
        turn = angular + self.slip
        # Midpoint heading keeps circles closed.
        mid = self.yaw + 0.5 * turn * dt
        self.x += linear * math.cos(mid) * dt
        self.y += linear * math.sin(mid) * dt
        self.yaw = math.atan2(math.sin(self.yaw + turn * dt), math.cos(self.yaw + turn * dt))

    def antenna(self, ax, ay):
        c, s = math.cos(self.yaw), math.sin(self.yaw)
        return self.x + c * ax - s * ay, self.y + s * ax + c * ay

    def antenna_velocity(self, ax, ay):
        """East and north velocity of the antenna."""
        c, s = math.cos(self.yaw), math.sin(self.yaw)
        return (self.linear * c - self.angular * (s * ax + c * ay), self.linear * s + self.angular * (c * ax - s * ay))


FAST_SPEED_GAP = 0.075
FAST_SPEED_RUN = 3
FAST_SPEED_HOLD = 3.6


class HostLink:
    """The setpoint the MCU holds: up to `timeout` s after the last SpeedData, `fast_hold` s after FAST_SPEED_RUN
    SpeedData in a row each less than FAST_SPEED_GAP s apart (a single short gap is read jitter), and not during a lift
    or stop. The blade stops once no frame at all came for
    `timeout` s, unless the flag cutter_holds keeps it."""

    def __init__(self, timeout, fast_hold=0.0):
        self.timeout = timeout
        self.fast_hold = fast_hold
        self.linear = self.angular = 0.0
        self.last_rx = None
        self.last_speed = None
        self.fast_run = 0

    def on_frame(self, now):
        self.last_rx = now

    def on_speed(self, linear, angular, now):
        self.linear, self.angular = linear, angular
        fast = self.last_speed is not None and now - self.last_speed < FAST_SPEED_GAP
        self.fast_run = self.fast_run + 1 if fast else 0
        self.last_speed = now

    def silent(self, now):
        return self.last_rx is None or now - self.last_rx > self.timeout

    def setpoint(self, now, blocked):
        """The (linear, angular) to drive now. A timeout or a block clears the held setpoint."""
        hold = max(self.timeout, self.fast_hold) if self.fast_run >= FAST_SPEED_RUN else self.timeout
        if blocked or self.last_speed is None or now - self.last_speed > hold:
            self.linear = self.angular = 0.0
        return self.linear, self.angular


class Drive:
    """Two wheels: the MCU splits a setpoint on mcu_track, the base turns on the real track."""

    def __init__(self, mcu_track, track):
        self.mcu_track, self.track = mcu_track, track
        self.left = self.right = 0.0

    def move(self, linear, angular, deadband=0.0):
        """The (linear, angular) the base drives for a setpoint; a wheel slower than the deadband stands."""
        half = angular * self.mcu_track / 2.0
        self.left, self.right = (0.0 if abs(v) < deadband else v for v in (linear - half, linear + half))
        return (self.left + self.right) / 2.0, (self.right - self.left) / self.track

    def measured(self, scale=1.0):
        """The (linear, angular) the MCU reports: its wheel speeds times scale, on its own track."""
        return scale * (self.left + self.right) / 2.0, scale * (self.right - self.left) / self.mcu_track

    def standing(self):
        return self.left == 0.0 and self.right == 0.0

    def rpm(self):
        """(left, right) rpm of the drive motors at their wheels."""
        return tuple(int(round(v / (2.0 * math.pi * WHEEL_RADIUS) * 60.0)) for v in (self.left, self.right))


# Wheel radius of the Tron (URDF), for the rpm of the motor report.
WHEEL_RADIUS = 0.10


def standstill_noise(rng):
    """(linear, angular) the Tron reports for standing wheels (07.11., 49 s at rest): the turn rate scatters, about one
    report in a hundred has one wheel at one step of 0.0067 m/s."""
    if rng.random() < 0.01:
        side = rng.choice((-1.0, 1.0))
        return side * 0.0033, rng.choice((-1.0, 1.0)) * 0.0167
    return 0.0, max(-0.02, min(0.02, rng.gauss(0.0, 0.004)))


# The charging station: the stop (its housing) holds the mower up to DOCK_STOP_ACROSS m to the side of the contacts;
# contact needs the mower's contacts within DOCK_CONTACT_ACROSS m across and its heading within DOCK_CONTACT_YAW of the
# docked one after DOCK_PUSH_TIME s of pushing, and holds while they stay within DOCK_CONTACT_GAP m of the station's.
# The drive wheels stand in hollows (10 mm deep, measured): base_link within DOCK_HOLLOW m of where it stands docked
# leaves them only while the slower wheel turns at DOCK_HOLLOW_SPEED m/s or more. Assumptions until measured in phase 7.
DOCK_STOP_ACROSS = 0.10
DOCK_CONTACT_ACROSS = 0.02
DOCK_CONTACT_YAW = math.radians(5.0)
DOCK_PUSH_TIME = 1.0
DOCK_CONTACT_GAP = 0.005
DOCK_HOLLOW = 0.05
DOCK_HOLLOW_SPEED = 0.10


def stall(pose, drive):
    """The wheels stall against the station or at the edge of its hollows: the base neither drives nor turns, so the
    gyro, the GNSS velocity and the wheel report see no motion."""
    pose.linear = pose.angular = pose.slip = 0.0
    drive.left = drive.right = 0.0


class Dock:
    """A charging station placed like one of map.json: base_link of the docked mower at (x, y), heading the way the
    mower drives in. The mower's contacts lie contact_x m ahead of its base (negative: behind, it backs in and faces the
    other way on the station). The station's contacts span a plane across the heading that stops the base."""

    def __init__(self, x, y, heading, contact_x):
        self.x, self.y, self.heading, self.contact_x = x, y, heading, contact_x
        self.shift = (0.0, 0.0)
        self.contact = False
        self.pushing_since = None

    def docked_yaw(self):
        return self.heading + (math.pi if self.contact_x < 0 else 0.0)

    def place(self, pose):
        """(along, across, yaw error) of the mower's contacts to the station's; along > 0 is past them."""
        yaw = self.docked_yaw()
        cx = self.x + self.shift[0] + self.contact_x * math.cos(yaw)
        cy = self.y + self.shift[1] + self.contact_x * math.sin(yaw)
        dx = pose.x + self.contact_x * math.cos(pose.yaw) - cx
        dy = pose.y + self.contact_x * math.sin(pose.yaw) - cy
        hx, hy = math.cos(self.heading), math.sin(self.heading)
        error = pose.yaw - yaw
        return dx * hx + dy * hy, dy * hx - dx * hy, math.atan2(math.sin(error), math.cos(error))

    def stop(self, before, pose):
        """Ends a step from before that runs into the station where the mower's contacts reach the plane: no sliding
        along the housing, no turning. True if it did."""
        along_before, _, _ = self.place(before)
        along, across, _ = self.place(pose)
        if along_before > 1e-6 or along <= 0.0 or abs(across) > DOCK_STOP_ACROSS:
            return False
        pose.x = before.x - along_before * math.cos(self.heading)
        pose.y = before.y - along_before * math.sin(self.heading)
        pose.yaw = before.yaw
        return True

    def hold(self, before, pose, wheel_speed, hollow_speed=DOCK_HOLLOW_SPEED):
        """Ends a step from before that takes the wheels out of the hollows while the slower of them (wheel_speed, m/s
        either way) turns slower than hollow_speed: they stand at the edge. True if it did."""
        along_before, across, _ = self.place(before)
        along, _, _ = self.place(pose)
        in_hollow = -DOCK_HOLLOW < along_before <= DOCK_CONTACT_GAP and abs(across) <= DOCK_STOP_ACROSS
        if not in_hollow or along >= along_before or wheel_speed >= hollow_speed:
            return False
        pose.x, pose.y, pose.yaw = before.x, before.y, before.yaw
        return True

    def update(self, now, pose, pushing):
        """The contact for the mower at pose; pushing: the station stopped it just now."""
        along, across, error = self.place(pose)
        if abs(along) > DOCK_CONTACT_GAP or abs(across) > DOCK_CONTACT_ACROSS or abs(error) > DOCK_CONTACT_YAW:
            self.contact = False
            self.pushing_since = None
        elif not self.contact and pushing:
            if self.pushing_since is None:
                self.pushing_since = now
            self.contact = now - self.pushing_since >= DOCK_PUSH_TIME
        elif not pushing:
            self.pushing_since = None
        return self.contact

    def settle(self, pose):
        """A mower placed on the station has contact at once."""
        along, across, error = self.place(pose)
        self.contact = (abs(along) <= DOCK_CONTACT_GAP and abs(across) <= DOCK_CONTACT_ACROSS and
                        abs(error) <= DOCK_CONTACT_YAW)
        return self.contact

    def move(self, shift, pose):
        """Moves the station to shift (m from where it was placed), the mower with it while it has contact."""
        if self.contact:
            pose.x += shift[0] - self.shift[0]
            pose.y += shift[1] - self.shift[1]
        self.shift = shift


class History:
    """Values of the last limit seconds, to send them late."""

    def __init__(self, limit=1.0):
        self.limit = limit
        self.items = collections.deque()

    def push(self, now, value):
        self.items.append((now, value))
        while len(self.items) > 1 and self.items[1][0] <= now - self.limit:
            self.items.popleft()

    def get(self, now, delay):
        """The newest value at least delay seconds old, else the oldest one kept."""
        due = now - min(max(delay, 0.0), self.limit)
        result = self.items[0][1]
        for t, value in self.items:
            if t > due:
                break
            result = value
        return result


def enu_to_geodetic(datum, east, north, up):
    """(lat deg, lon deg, height m) of an ENU offset to the datum (lat deg, lon deg, height m)."""
    lat0, lon0 = math.radians(datum[0]), math.radians(datum[1])
    sl, cl, sp, cp = math.sin(lon0), math.cos(lon0), math.sin(lat0), math.cos(lat0)
    n0 = WGS84_A / math.sqrt(1.0 - WGS84_E2 * sp * sp)
    ox = (n0 + datum[2]) * cp * cl
    oy = (n0 + datum[2]) * cp * sl
    oz = (n0 * (1.0 - WGS84_E2) + datum[2]) * sp
    x = ox - sl * east - sp * cl * north + cp * cl * up
    y = oy + cl * east - sp * sl * north + cp * sl * up
    z = oz + cp * north + sp * up
    lon = math.atan2(y, x)
    p = math.hypot(x, y)
    lat = math.atan2(z, p * (1.0 - WGS84_E2))
    height = 0.0
    for _ in range(8):
        n = WGS84_A / math.sqrt(1.0 - WGS84_E2 * math.sin(lat) ** 2)
        height = p / math.cos(lat) - n
        lat = math.atan2(z, p * (1.0 - WGS84_E2 * n / (n + height)))
    return math.degrees(lat), math.degrees(lon), height


def nmea(body):
    checksum = 0
    for c in body.encode():
        checksum ^= c
    return f"${body}*{checksum:02X}\r\n".encode()


def nmea_coordinate(value, positive, negative, degree_digits):
    hemisphere = positive if value >= 0 else negative
    value = abs(value)
    degrees = int(value)
    # Rounded first: 59.99999999 would print as 60.0000000, which a receiver never sends (and tron_gnss drops).
    minutes = round((value - degrees) * 60.0, 7)
    if minutes >= 60.0:
        degrees += 1
        minutes -= 60.0
    return f"{degrees:0{degree_digits}d}{minutes:010.7f}", hemisphere


def gnss_sentences(utc, lat, lon, height, quality, speed, course, age=1.0):
    """GGA, RMC and VTG as bytes. Quality 0 gives no position, a missing course leaves the course fields empty, a missing
    age the age and station of the corrections."""
    stamp = utc.strftime("%H%M%S.") + f"{utc.microsecond // 10000:02d}"
    date = utc.strftime("%d%m%y")
    if quality in (1, 2, 4, 5, 6):
        la, ns = nmea_coordinate(lat, "N", "S", 2)
        lo, ew = nmea_coordinate(lon, "E", "W", 3)
        position = f"{la},{ns},{lo},{ew}"
        corrections = "," if age is None else f"{age:.1f},0000"
        gga = f"GNGGA,{stamp},{position},{quality},24,0.6,{height:.3f},M,0.0,M,{corrections}"
        status, mode = "A", "R" if quality in (4, 5) else "A"
    else:
        gga = f"GNGGA,{stamp},,,,,0,00,99.99,,,,,,"
        position, status, mode = ",,,", "V", "N"
    course_text = "" if course is None else f"{course:.2f}"
    knots = speed / KNOTS
    rmc = f"GNRMC,{stamp},{status},{position},{knots:.3f},{course_text},{date},,,{mode}"
    vtg = f"GNVTG,{course_text},T,,M,{knots:.3f},N,{speed * 3.6:.3f},K,{mode}"
    return nmea(gga) + nmea(rmc) + nmea(vtg)


BOARD_ON = b"$GNRTK,ON*69\r\n"
BOARD_RESET = b"RTKRESET\r\n"
# The board falls back to LoRa after this long without a byte from the host.
BOARD_TIMEOUT = 6.0
BOARD_REPORT_PERIOD = 1.0
# The receiver keeps RTK fixed on corrections this old.
RECEIVER_MAX_AGE = 120.0


def _crc24q_table():
    """Remainder of each top byte under the RTCM 3 polynomial 0x1864CFB."""
    table = []
    for top in range(256):
        value = top << 16
        for _ in range(8):
            value = (value << 1) ^ (0x1864CFB if value & 0x800000 else 0)
        table.append(value & 0xFFFFFF)
    return table


CRC24Q_TABLE = _crc24q_table()


def crc24q(data):
    """CRC-24Q of RTCM 3, a byte at a time from the table."""
    remainder = 0
    for value in data:
        remainder = ((remainder << 8) & 0xFFFFFF) ^ CRC24Q_TABLE[(remainder >> 16) ^ value]
    return remainder


class Board:
    """The RTK board (AT32) between host and receiver: in LoRa mode (OFF) at the start, network RTK (ON) after the exact
    bytes of BOARD_ON, OFF again after BOARD_TIMEOUT s without any byte from the host. Only while ON it passes RTCM
    frames with a valid CRC to the receiver. RTKRESET restarts the receiver: its corrections are gone. Reports
    $GNRTK,ON / OFF on each change and every BOARD_REPORT_PERIOD s (format assumed until phase 5)."""

    def __init__(self):
        self.on = False
        self.buffer = b""
        self.last_host = None
        self.last_rtcm = None
        self.frames = self.dropped = self.resets = 0

    def feed(self, now, data):
        """Bytes from the host; returns log entries."""
        self.last_host = now
        self.buffer += data
        entries = []
        while self.buffer:
            if self.buffer.startswith(BOARD_ON):
                self.buffer = self.buffer[len(BOARD_ON):]
                entries.append({"board": "on_command"})
                self.on = True
            elif self.buffer.startswith(BOARD_RESET):
                self.buffer = self.buffer[len(BOARD_RESET):]
                self.resets += 1
                self.last_rtcm = None
                entries.append({"board": "reset"})
            elif self.buffer[0] == 0xD3:
                if len(self.buffer) < 3:
                    break
                total = 3 + (((self.buffer[1] & 0x03) << 8) | self.buffer[2]) + 3
                if len(self.buffer) < total:
                    break
                frame, self.buffer = self.buffer[:total], self.buffer[total:]
                if crc24q(frame[:-3]) != int.from_bytes(frame[-3:], "big"):
                    entries.append({"board": "bad_rtcm"})
                elif self.on:
                    self.frames += 1
                    self.last_rtcm = now
                    entries.append({"rtcm": (frame[3] << 4) | (frame[4] >> 4) if total > 7 else 0})
                else:
                    self.dropped += 1
                    entries.append({"board": "rtcm_dropped"})
            elif BOARD_ON.startswith(self.buffer) or BOARD_RESET.startswith(self.buffer):
                break
            else:
                self.buffer = self.buffer[1:]
        return entries

    def tick(self, now):
        """True if the board fell back to LoRa just now."""
        if self.on and (self.last_host is None or now - self.last_host > BOARD_TIMEOUT):
            self.on = False
            return True
        return False

    def report(self):
        return nmea("GNRTK," + ("ON" if self.on else "OFF"))

    def fix(self, now):
        """(quality, age) of the receiver from the corrections it got."""
        if self.last_rtcm is None or now - self.last_rtcm > RECEIVER_MAX_AGE:
            return 1, None
        return 4, round(now - self.last_rtcm, 1)


def wit_frame(frame_type, values):
    body = bytearray([0x55, frame_type])
    for v in values:
        body.extend(struct.pack("<h", v))
    body.append(sum(body) % 256)
    return bytes(body)


def wit_scaled(value, full_scale):
    return max(-32768, min(32767, round(value / full_scale * 32768.0)))


def rotation_rpy(roll, pitch, yaw):
    """Rz(yaw) Ry(pitch) Rx(roll), built from the three single-axis turns."""
    cr, sr = math.cos(roll), math.sin(roll)
    cp, sp = math.cos(pitch), math.sin(pitch)
    cy, sy = math.cos(yaw), math.sin(yaw)
    turn_x = [[1.0, 0.0, 0.0], [0.0, cr, -sr], [0.0, sr, cr]]
    turn_y = [[cp, 0.0, sp], [0.0, 1.0, 0.0], [-sp, 0.0, cp]]
    turn_z = [[cy, -sy, 0.0], [sy, cy, 0.0], [0.0, 0.0, 1.0]]
    return matmul(turn_z, matmul(turn_y, turn_x))


def matmul(a, b):
    columns = list(zip(*b))
    return [[sum(x * y for x, y in zip(row, col)) for col in columns] for row in a]


def transpose(a):
    return [list(col) for col in zip(*a)]


def ground(slope_deg, slope_heading_deg):
    """The turn of a ground that rises by slope_deg towards slope_heading_deg (map frame): about the level axis across
    that heading."""
    axis = math.radians(slope_heading_deg) + math.pi / 2
    angle = -math.radians(slope_deg)
    # Rodrigues for the unit axis (cos a, sin a, 0).
    ux, uy = math.cos(axis), math.sin(axis)
    c, s = math.cos(angle), math.sin(angle)
    return [[c + ux * ux * (1 - c), ux * uy * (1 - c), uy * s],
            [uy * ux * (1 - c), c + uy * uy * (1 - c), -ux * s],
            [-uy * s, ux * s, c]]


def wit_frames(pose, mount_rpy_deg, gyro_bias_dps=0.0, tilt_deg=(0.0, 0.0), error_rpy_deg=(0.0, 0.0, 0.0),
               slope=(0.0, 0.0), gyro_scale=1.0):
    """Acceleration, rate and angle frames of the base, tilted by roll and pitch (in the frame of the base) and standing
    on the slope (in the map frame), with the sensor turned by the mount rotation and off it by the error rotation.

    The driver turns sensor to base with R_mount; so the sensor sees the base through its transpose. The error is the
    mounting the calibration drive finds: on level ground the driver's IMU reads gravity turned by it.
    """
    mount = matmul(rotation_rpy(*(math.radians(a) for a in error_rpy_deg)),
                   rotation_rpy(*(math.radians(a) for a in mount_rpy_deg)))
    to_sensor = transpose(mount)
    base = matmul(ground(*slope), rotation_rpy(math.radians(tilt_deg[0]), math.radians(tilt_deg[1]), pose.yaw))
    r_sensor = matmul(base, mount)
    # Without acceleration the accelerometer reads 1 g up, in the frame of the sensor; the gyro the yaw rate about the
    # axis of the base, gyro_scale times.
    acc = [r_sensor[2][i] for i in range(3)]
    turn = (pose.angular + pose.slip) * gyro_scale
    rate = [math.degrees(to_sensor[i][2] * turn) + (gyro_bias_dps if i == 2 else 0.0) for i in range(3)]
    roll = math.degrees(math.atan2(r_sensor[2][1], r_sensor[2][2]))
    pitch = math.degrees(math.asin(max(-1.0, min(1.0, -r_sensor[2][0]))))
    yaw = math.degrees(math.atan2(r_sensor[1][0], r_sensor[0][0]))
    return (wit_frame(0x51, [wit_scaled(a, 16.0) for a in acc] + [0]) +
            wit_frame(0x52, [wit_scaled(r, 2000.0) for r in rate] + [0]) +
            wit_frame(0x53, [wit_scaled(a, 180.0) for a in (roll, pitch, yaw)] + [0]))


def noisy(rng, sigma, east, north):
    """The antenna position with a normal error of sigma metres on each axis."""
    if sigma <= 0.0:
        return east, north
    return east + rng.gauss(0.0, sigma), north + rng.gauss(0.0, sigma)


def open_pty(link):
    """Master end of a new pty, symlinked at link. The slave stays closed so a driver may open it."""
    master, slave = os.openpty()
    tty.setraw(master)
    # The ports of the Tron keep the 115200 baud their driver set, also after it closed them.
    attrs = termios.tcgetattr(master)
    attrs[4] = attrs[5] = termios.B115200
    termios.tcsetattr(master, termios.TCSANOW, attrs)
    os.set_blocking(master, False)
    if os.path.lexists(link):
        os.remove(link)
    os.symlink(os.ttyname(slave), link)
    os.close(slave)
    return master


class Port:
    """A serial port of the Tron as the master of a pty. A driver that dies leaves its TIOCEXCL on the pty, which a real
    port drops with its last close, so once the driver that had it open is gone a new pty takes the link."""

    def __init__(self, link):
        self.link = link
        self.fd = open_pty(link)
        self.used = False
        self.poll = select.poll()
        self.poll.register(self.fd, select.POLLHUP)

    def renew_if_left(self):
        """True when the driver left and the pty was replaced; without an open slave the master reports a hangup."""
        if not self.poll.poll(0):
            self.used = True
            return False
        if not self.used:
            return False
        self.poll.unregister(self.fd)
        os.close(self.fd)
        self.fd = open_pty(self.link)
        self.poll.register(self.fd, select.POLLHUP)
        self.used = False
        return True


def remove_links(links):
    for link in links:
        if os.path.islink(link):
            os.remove(link)


SEND_ERRORS = {}


def send(fd, data):
    """Writes to a pty; a driver that does not read (full buffer) or is not there costs the data, the first error of
    each kind is reported."""
    try:
        os.write(fd, data)
    except OSError as e:
        key = (fd, e.errno)
        SEND_ERRORS[key] = SEND_ERRORS.get(key, 0) + 1
        if SEND_ERRORS[key] == 1:
            print(f"fake_tron: writing to {os.ttyname(fd) if os.isatty(fd) else fd} failed: {e}", file=sys.stderr,
                  flush=True)


def state_text(now, pose, dock_ok=False, host_bytes=0):
    return json.dumps({"t": round(now, 3), "x": pose.x, "y": pose.y, "yaw": pose.yaw, "linear": pose.linear,
                       "angular": pose.angular, "dock_ok": dock_ok, "host_bytes": host_bytes})


def write_state(path, text):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, path)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--link", default="/tmp/mowbite_sim_mcu", help="symlink to the MCU pty the driver opens")
    parser.add_argument("--gnss-link", default="/tmp/mowbite_sim_gnss", help="symlink to the GNSS pty")
    parser.add_argument("--imu-link", default="/tmp/mowbite_sim_imu", help="symlink to the IMU pty")
    parser.add_argument("--flags", help="JSON file with lift, stop, bumper, bumper_left, bumper_right, rain, dock, "
                        "host_timeout, gnss_quality, gnss_noise, "
                        "gnss_age, gnss_delay, yaw_drift, wheel_deadband, odom_scale, track, imu_off, cutter_ignores_off, "
                        "cutter_holds, "
                        "gnss_rtcm, dock_shift_x, dock_shift_y, dock_hollow_speed, place, tilt_roll, tilt_pitch, gyro_bias_dps, "
                        "charge_current, battery_percentage, battery_voltage, battery_temperature, blade_temperature, "
                        "standstill_noise, fast_speed_hold")
    parser.add_argument("--log", help="JSON lines log of received sub packets")
    parser.add_argument("--log-max-mb", type=float, default=20.0)
    parser.add_argument("--state", help="JSON file with the true pose, written 5 times a second")
    parser.add_argument("--host-timeout", type=float, default=0.2, help="seconds after the last SpeedData until stop")
    parser.add_argument("--fast-speed-hold", type=float, default=FAST_SPEED_HOLD,
                        help=f"seconds the setpoint lasts after SpeedData that came faster than every "
                             f"{FAST_SPEED_GAP * 1000:.0f} ms (0 off)")
    parser.add_argument("--standstill-noise", action="store_true",
                        help="standing wheels report the noise of the Tron (flag standstill_noise)")
    parser.add_argument("--datum", type=float, nargs=3, default=[52.0, 9.0, 50.0], metavar=("LAT", "LON", "H"),
                        help="geodetic origin of the local frame (test value, not a real garden)")
    parser.add_argument("--start", type=float, nargs=3, default=[0.0, 0.0, 0.0], metavar=("X", "Y", "YAW_DEG"))
    parser.add_argument("--antenna-offset", type=float, nargs=2, default=[0.098, 0.0], metavar=("X", "Y"))
    parser.add_argument("--mount-rpy-deg", type=float, nargs=3, default=[0.0, 0.0, 0.0],
                        help="IMU mount rotation, upright by default like the Tron")
    parser.add_argument("--gyro-bias-dps", type=float, default=0.0, help="constant yaw rate error of the sensor")
    parser.add_argument("--gyro-scale", type=float, default=1.0, help="measured / true yaw rate of the sensor")
    parser.add_argument("--imu-error-rpy-deg", type=float, nargs=3, default=[0.0, 0.0, 0.0],
                        help="the sensor turned off its configured mount: what the calibration measures")
    parser.add_argument("--slope", type=float, nargs=2, default=[0.0, 0.0], metavar=("DEG", "HEADING_DEG"),
                        help="the ground rises by DEG towards HEADING_DEG (map frame) everywhere")
    parser.add_argument("--gnss-noise-m", type=float, default=0.0, help="standard deviation of the antenna position")
    parser.add_argument("--yaw-drift", type=float, default=0.0, help="yaw error in rad per metre driven (slip)")
    parser.add_argument("--seed", type=int, default=1, help="seed of the position noise")
    parser.add_argument("--gnss-delay", type=float, default=0.0, help="age (s, at most 1) of the position when sent")
    parser.add_argument("--mcu-track", type=float, default=0.40, help="track (m) the MCU splits and reports on")
    parser.add_argument("--track", type=float, help="real track (m) the base turns on, default --mcu-track")
    parser.add_argument("--wheel-deadband", type=float, default=0.0, help="m/s below which a wheel stands")
    parser.add_argument("--odom-scale", type=float, default=1.0, help="reported / real wheel speed")
    parser.add_argument("--dock", type=float, nargs=3, metavar=("X", "Y", "HEADING_DEG"),
                        help="charging station like one of map.json: the docked base_link and the way in")
    parser.add_argument("--dock-contact-x", type=float, default=-0.10,
                        help="the mower's contacts ahead of base_link (m), negative: it backs onto the station")
    parser.add_argument("--dock-hollow-speed", type=float, default=DOCK_HOLLOW_SPEED,
                        help="m/s the slower wheel needs to climb out of the hollows of the station")
    args = parser.parse_args()

    # SIGTERM from launch or docker has to reach the finally block that removes the symlinks.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    atexit.register(remove_links, (args.link, args.gnss_link, args.imu_link))
    mcu = Port(args.link)
    gnss = Port(args.gnss_link)
    imu = Port(args.imu_link)
    files = Files(args.flags, args.state)
    log = Log(args.log, int(args.log_max_mb * 1e6), files)
    decoder = Decoder()
    board = Board()
    board_on = None
    next_report = gnss_quiet_until = 0.0
    pose = Pose(args.start[0], args.start[1], math.radians(args.start[2]))
    rng = random.Random(args.seed)
    noise_rng = random.Random(args.seed + 1)
    host_bytes = 0
    host = HostLink(args.host_timeout, args.fast_speed_hold)
    drive = Drive(args.mcu_track, args.track or args.mcu_track)
    antenna_history = History()
    course = None
    # Cutter: on with a speed in percent from the last cutter frame; it stops with the wheels (lift, stop, no host).
    cutter_percent = 0
    dock = Dock(args.dock[0], args.dock[1], math.radians(args.dock[2]), args.dock_contact_x) if args.dock else None
    if dock and dock.settle(pose):
        print("fake_tron: the mower starts on the docking station", file=sys.stderr, flush=True)
    # Charge from the last Charge frame of the host; the station only gives current while the mower has contact.
    charging = dock_ok = False
    placed = None

    t0 = time.monotonic()
    last = 0.0
    next_sensor = next_status = next_gnss = next_imu = next_state = next_port_check = 0.0
    try:
        while True:
            now = time.monotonic() - t0
            flags = files.flags
            # Somebody puts the mower down there by hand, once for each new value of the flag; lifting it drops the
            # setpoint the MCU held.
            place = flags.get("place")
            if place != placed:
                placed = place
                if place:
                    pose = Pose(float(place[0]), float(place[1]), math.radians(float(place[2])))
                    host.linear = host.angular = 0.0
                    log.write({"t": round(now, 3), "placed": [round(float(v), 3) for v in place]})
                    if dock and dock.settle(pose):
                        log.write({"t": round(now, 3), "dock": "contact"})
            blocked = bool(flags.get("lift", 0) or flags.get("stop", 0))
            host.timeout = float(flags.get("host_timeout", args.host_timeout))
            host.fast_hold = float(flags.get("fast_speed_hold", args.fast_speed_hold))
            drive.track = float(flags.get("track", args.track or args.mcu_track))
            linear, angular = drive.move(*host.setpoint(now, blocked),
                                         float(flags.get("wheel_deadband", args.wheel_deadband)))
            before = Pose(pose.x, pose.y, pose.yaw)
            pose.step(now - last, linear, angular, float(flags.get("yaw_drift", args.yaw_drift)))
            last = now
            pushing = False
            if dock:
                dock.move((float(flags.get("dock_shift_x", 0.0)), float(flags.get("dock_shift_y", 0.0))), pose)
                pushing = dock.stop(before, pose)
                held = not pushing and dock.hold(before, pose, min(abs(drive.left), abs(drive.right)),
                                                 float(flags.get("dock_hollow_speed", args.dock_hollow_speed)))
                if pushing or held:
                    stall(pose, drive)
                had_contact = dock.contact
                if dock.update(now, pose, pushing) != had_contact:
                    log.write({"t": round(now, 3), "dock": "contact" if dock.contact else "free"})
            dock_ok = bool(flags.get("dock", 0)) or bool(dock and dock.contact)
            if not dock_ok:
                charging = False
            antenna_history.push(now, (pose.antenna(*args.antenna_offset), pose.antenna_velocity(*args.antenna_offset)))

            if now >= next_sensor:
                next_sensor = now + SENSOR_PERIOD
                # bumper (one of both) stands for the right one
                right = int(bool(flags.get("bumper", 0) or flags.get("bumper_right", 0)))
                left = int(bool(flags.get("bumper_left", 0)))
                # bumper, rain, lift, stop, power_off, battery_gate, cutter_size (2 = large), press_module, right, left
                sensor = bytes([right | left, int(flags.get("rain", 0)), int(flags.get("lift", 0)),
                                int(flags.get("stop", 0)), 0, 0, 2, 0, right, left])
                measured = drive.measured(float(flags.get("odom_scale", args.odom_scale)))
                if drive.standing() and flags.get("standstill_noise", args.standstill_noise):
                    measured = standstill_noise(noise_rng)
                send(mcu.fd, encode([(FROM_MCU, 10, sensor), (FROM_MCU, 4, struct.pack("<ff", *measured))]))
            if now >= next_status:
                next_status = now + 1.0
                # 0.1 V steps, charging on the dock after Charge 1 (0.1 A steps, negative) or 1.2 A discharging
                percentage = max(0, min(100, int(flags.get("battery_percentage", 80))))
                amps = float(flags.get("charge_current", 3.0)) if charging and percentage < 100 else 0.0
                current = -int(round(amps * 10)) if amps > 0 else 12
                decivolts = max(0, min(0xFFFF, int(round(float(flags.get("battery_voltage", 24.5)) * 10))))
                battery = struct.pack("<HhBbbI", decivolts, current, percentage, int(dock_ok),
                                      celsius(flags.get("battery_temperature", 30)), 0)
                left_rpm, right_rpm = drive.rpm()
                motors = b"".join(struct.pack("<hhhbb", rpm, 0, 2450, 30, 0)
                                  for rpm in (-right_rpm, -left_rpm, 0))
                if blocked or (host.silent(now) and not flags.get("cutter_holds", 0)):
                    cutter_percent = 0
                # Assumed 2800 rpm at full speed, 0.8 A while turning (10 mA steps).
                cutter = struct.pack("<hhhbb", 28 * cutter_percent, 80 if cutter_percent else 0, 2450,
                                     celsius(flags.get("blade_temperature", 30)), 0)
                version = bytes([0, 6, 36, 0, 6, 34, 0, 0, 0])
                send(mcu.fd, encode([(FROM_MCU, 5, battery), (FROM_MCU, 12, version),
                                  (FROM_MCU, 13, cutter + motors)]))
            if now >= next_gnss:
                next_gnss = now + GNSS_PERIOD
                sigma = float(flags.get("gnss_noise", args.gnss_noise_m))
                # The receiver sends the position of an earlier epoch, with the time of that epoch.
                delay = min(max(float(flags.get("gnss_delay", args.gnss_delay)), 0.0), antenna_history.limit)
                antenna, (vx, vy) = antenna_history.get(now, delay)
                ax, ay = noisy(rng, sigma, *antenna)
                speed = math.hypot(vx, vy)
                if speed > 0.01:
                    course = math.degrees(math.atan2(vx, vy)) % 360.0
                lat, lon, height = enu_to_geodetic(args.datum, ax, ay, 0.0)
                age = flags.get("gnss_age", 1.0)
                quality = int(flags.get("gnss_quality", 4))
                if flags.get("gnss_rtcm", 0):
                    quality, age = board.fix(now)
                epoch = datetime.datetime.now(datetime.timezone.utc) - datetime.timedelta(seconds=delay)
                send(gnss.fd, gnss_sentences(epoch, lat, lon, height, quality, speed, course,
                                          None if age is None else float(age)))
            board.tick(now)
            if board.on != board_on or now >= next_report:
                if board.on != board_on:
                    log.write({"t": round(now, 3), "board": "on" if board.on else "off"})
                board_on = board.on
                next_report = now + BOARD_REPORT_PERIOD
                send(gnss.fd, board.report())
            if now >= next_imu:
                next_imu = now + IMU_PERIOD
                if not flags.get("imu_off", 0):
                    tilt = (float(flags.get("tilt_roll", 0.0)), float(flags.get("tilt_pitch", 0.0)))
                    bias = float(flags.get("gyro_bias_dps", args.gyro_bias_dps))
                    send(imu.fd, wit_frames(pose, args.mount_rpy_deg, bias, tilt, args.imu_error_rpy_deg,
                                            (args.slope[0], args.slope[1]), args.gyro_scale))
            if args.state and now >= next_state:
                next_state = now + 0.2
                files.state(state_text(now, pose, dock_ok, host_bytes))

            if now >= next_port_check:
                next_port_check = now + 0.1
                for name, port in (("mcu", mcu), ("gnss", gnss), ("imu", imu)):
                    if port.renew_if_left():
                        log.write({"t": round(now, 3), "renewed": name})

            # Without a driver on it a pty reads as an error at once: then look again only after 0.1 s.
            ready, _, _ = select.select([mcu.fd, gnss.fd] if now >= gnss_quiet_until else [mcu.fd], [], [], 0.005)
            if gnss.fd in ready:
                try:
                    for entry in board.feed(now, os.read(gnss.fd, 4096)):
                        log.write({"t": round(now, 3), **entry})
                except OSError:
                    gnss_quiet_until = now + 0.1
            if mcu.fd not in ready:
                continue
            try:
                data = os.read(mcu.fd, 4096)
            except OSError:
                continue
            host_bytes += len(data)
            for packets in decoder.feed(data):
                if packets is None:
                    log.write({"t": round(now, 3), "bad": True})
                    continue
                host.on_frame(now)
                for packet_type, module, payload in packets:
                    entry = {"t": round(now, 3), "type": packet_type, "mod": module, "hex": payload.hex()}
                    if packet_type == TO_MCU and module == 4 and len(payload) == 8:
                        speed_cmd = struct.unpack("<ff", payload)
                        # SpeedData is ignored while the MCU is locked by lift or stop.
                        if not blocked:
                            host.on_speed(*speed_cmd, now)
                        entry["speed"] = [round(v, 3) for v in speed_cmd]
                    if packet_type == TO_MCU and module == 3 and len(payload) >= 1:
                        charging = payload[0] == 1 and dock_ok
                        entry["charge"] = payload[0]
                    if packet_type == TO_MCU and module == 11 and len(payload) >= 4:
                        on = payload[0] == 1
                        if on or not flags.get("cutter_ignores_off", 0):
                            cutter_percent = min(100, struct.unpack("<H", payload[2:4])[0]) if on and not blocked else 0
                        entry["cutter"] = cutter_percent
                    log.write(entry)
    finally:
        remove_links((args.link, args.gnss_link, args.imu_link))
        files.close()


if __name__ == "__main__":
    main()
