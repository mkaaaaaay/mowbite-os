#!/usr/bin/env python3
"""Simulated cutter board of the Airseekers Tron on a pty.

Sends sensor, speed, battery, version and motor frames like the real MCU and answers speed commands with the commanded
speed. Optional: a JSON file with flags (lift, stop, bumper, rain, dock) is read on every cycle, and every received sub
packet is written to a JSON lines log.
"""
import argparse
import json
import os
import select
import struct
import time
import tty

FRAME_START = 0xA5
FRAME_END = 0x5A
ESCAPE = 0xF5
ESCAPE_CODE = {FRAME_START: 0x01, FRAME_END: 0x02, ESCAPE: 0x03}
ESCAPED_BYTE = {code: raw for raw, code in ESCAPE_CODE.items()}

TO_MCU = 0x00
FROM_MCU = 0x08


def encode(subpackets):
    """One frame from (type, module, payload) tuples."""
    inner = bytearray([0])
    for packet_type, module, payload in subpackets:
        inner.extend((len(payload), packet_type, module))
        inner.extend(payload)
    inner[0] = len(inner) - 1
    inner.append(sum(inner) % 256)
    out = bytearray([FRAME_START])
    for b in inner:
        out.extend((ESCAPE, ESCAPE_CODE[b]) if b in ESCAPE_CODE else (b,))
    out.append(FRAME_END)
    return bytes(out)


class Decoder:
    """Byte stream to frames. A start byte inside a frame begins a new one."""

    def __init__(self):
        self.inner = None
        self.pending_escape = False

    def feed(self, data):
        for b in data:
            if b == FRAME_START:
                self.inner = bytearray()
                self.pending_escape = False
            elif self.inner is None:
                continue
            elif b == FRAME_END:
                yield self._split(self.inner)
                self.inner = None
            elif self.pending_escape:
                self.inner.append(ESCAPED_BYTE.get(b, b))
                self.pending_escape = False
            elif b == ESCAPE:
                self.pending_escape = True
            else:
                self.inner.append(b)

    @staticmethod
    def _split(inner):
        """List of (type, module, payload), or None for a broken frame."""
        if len(inner) < 2 or inner[0] != len(inner) - 2 or sum(inner[:-1]) % 256 != inner[-1]:
            return None
        packets = []
        body = inner[1:-1]
        while body:
            size = body[0]
            if len(body) < 3 + size:
                return None
            packets.append((body[1], body[2], bytes(body[3:3 + size])))
            body = body[3 + size:]
        return packets


def read_flags(path):
    if not path:
        return {}
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


class Log:
    """JSON lines, stops writing at max_bytes."""

    def __init__(self, path, max_bytes):
        self.file = open(path, "w") if path else None
        self.left = max_bytes

    def write(self, entry):
        if not self.file or self.left <= 0:
            return
        line = json.dumps(entry) + "\n"
        self.left -= len(line)
        self.file.write(line)
        self.file.flush()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--link", default="/tmp/mowbite_sim_mcu", help="symlink to the pty the driver opens")
    parser.add_argument("--flags", help="JSON file with lift, stop, bumper, rain, dock")
    parser.add_argument("--log", help="JSON lines log of received sub packets")
    parser.add_argument("--log-max-mb", type=float, default=20.0)
    args = parser.parse_args()

    master, slave = os.openpty()
    tty.setraw(master)
    if os.path.lexists(args.link):
        os.remove(args.link)
    os.symlink(os.ttyname(slave), args.link)
    # The driver refuses ports another process has open.
    os.close(slave)
    log = Log(args.log, int(args.log_max_mb * 1e6))
    decoder = Decoder()

    t0 = time.monotonic()
    speed = (0.0, 0.0)
    next_sensor = next_status = 0.0
    try:
        while True:
            now = time.monotonic() - t0
            flags = read_flags(args.flags)
            out = []
            if now >= next_sensor:
                next_sensor = now + 0.02
                bumper = int(flags.get("bumper", 0))
                # bumper, rain, lift, stop, power_off, battery_gate, cutter_size (2 = large), press_module, right, left
                sensor = bytes([bumper, int(flags.get("rain", 0)), int(flags.get("lift", 0)),
                                int(flags.get("stop", 0)), 0, 0, 2, 0, bumper, 0])
                out.append(encode([(FROM_MCU, 10, sensor), (FROM_MCU, 4, struct.pack("<ff", *speed))]))
            if now >= next_status:
                next_status = now + 1.0
                dock = int(flags.get("dock", 0))
                # 24.5 V, -3.0 A charging on the dock or 1.2 A discharging, 80 %, 30 degC
                battery = struct.pack("<HhBbbI", 245, -30 if dock else 12, 80, dock, 30, 0)
                motor = struct.pack("<hhhbb", 0, 0, 2450, 30, 0)
                version = bytes([0, 6, 36, 0, 6, 34, 0, 0, 0])
                out.append(encode([(FROM_MCU, 5, battery), (FROM_MCU, 12, version), (FROM_MCU, 13, motor * 4)]))
            for data in out:
                try:
                    os.write(master, data)
                except OSError:
                    pass

            ready, _, _ = select.select([master], [], [], 0.005)
            if not ready:
                continue
            try:
                data = os.read(master, 4096)
            except OSError:
                continue
            for packets in decoder.feed(data):
                if packets is None:
                    log.write({"t": round(now, 3), "bad": True})
                    continue
                for packet_type, module, payload in packets:
                    entry = {"t": round(now, 3), "type": packet_type, "mod": module, "hex": payload.hex()}
                    if packet_type == TO_MCU and module == 4 and len(payload) == 8:
                        speed = struct.unpack("<ff", payload)
                        entry["speed"] = [round(v, 3) for v in speed]
                    log.write(entry)
    finally:
        if os.path.lexists(args.link):
            os.remove(args.link)


if __name__ == "__main__":
    main()
