#!/usr/bin/env python3
"""A broker that only speaks MQTT 3.1.1, for tests of the bridge: a TCP front of a real broker.

A CONNECT of MQTT 5 is refused the way an older broker does it (--mode connack: CONNACK 0x01, unacceptable protocol
version, then the end) or the connection just ends (--mode close); every other connection goes through to the broker
behind it unchanged.
"""
import argparse
import socket
import threading

MQTT5 = 5
REFUSED_PROTOCOL = bytes([0x20, 0x02, 0x00, 0x01])
MAX_HEAD = 4096


def protocol_level(head):
    """The protocol level of the CONNECT at the start of head, None while it is not all there yet."""
    # Past the fixed header: its type byte and the remaining length in one to four bytes.
    i = 1
    while True:
        if i >= len(head):
            return None
        more = head[i] & 0x80
        i += 1
        if not more or i > 4:
            break
    if len(head) < i + 2:
        return None
    name_length = head[i] << 8 | head[i + 1]
    at = i + 2 + name_length
    return head[at] if len(head) > at else None


def pipe(source, target):
    try:
        while data := source.recv(65536):
            target.sendall(data)
    except OSError:
        pass
    for s in (source, target):
        try:
            s.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass


def serve(client, mode, upstream):
    with client:
        head = b""
        level = None
        while level is None and len(head) < MAX_HEAD:
            data = client.recv(MAX_HEAD)
            if not data:
                return
            head += data
            level = protocol_level(head)
        if level is None or level == MQTT5:
            if level == MQTT5 and mode == "connack":
                client.sendall(REFUSED_PROTOCOL)
            return
        with socket.create_connection(("127.0.0.1", upstream)) as broker:
            broker.sendall(head)
            back = threading.Thread(target=pipe, args=(broker, client), daemon=True)
            back.start()
            pipe(client, broker)
            back.join(5)


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("--port", type=int, required=True, help="where it listens, on 127.0.0.1")
    parser.add_argument("--upstream", type=int, required=True, help="port of the real broker on 127.0.0.1")
    parser.add_argument("--mode", choices=["connack", "close"], default="connack")
    args = parser.parse_args()
    server = socket.create_server(("127.0.0.1", args.port), backlog=16)
    while True:
        client, _ = server.accept()
        threading.Thread(target=serve, args=(client, args.mode, args.upstream), daemon=True).start()


if __name__ == "__main__":
    main()
