# Copy to .env next to the compose file on the mower and fill in. Nothing secret goes here: the NTRIP access lives in
# <data_dir>/ntrip.yaml, entered on the mower.
# Image tags of MowBite OS and of the app (the form of the OS tag comes with the updater).
# An OS image from the artifact of the workflow os-image (docker load) has the tag <commit>-arm64.
MOWBITE_OS_TAG=
MOWBITE_APP_TAG=
# Address the phone reaches the mower at, for the WebSocket of the app.
MOWER_HOST=
# The datum of the garden (WGS84), kept out of the repo.
MOWBITE_DATUM_LAT=
MOWBITE_DATUM_LONG=
MOWBITE_DATUM_HEIGHT=
# Local time for the heartbeat of the MCU and for schedules.
TZ=Europe/Berlin
# NX60i only: where data_dir lives on the CM4 (/ has little room, Phase 5 decides).
MOWBITE_DATA_DIR=
# NX60i only: the journal of the cores, not inside MOWBITE_DATA_DIR (at most 64 MB, nx60i.yaml).
MOWBITE_JOURNAL_DIR=
