# Copy to .env next to the compose file on the mower and fill in. Nothing secret goes here: the NTRIP access lives in
# <data_dir>/ntrip.yaml, entered on the mower.
# Image tags of MowBite OS and of the app (the form of the OS tag comes with the updater); the NX60i needs no app tag.
# An OS image from the artifact of the workflow os-image (docker load) has the tag <commit>-arm64.
MOWBITE_OS_TAG=
MOWBITE_APP_TAG=
# The platform of this mower (nx60i without one) and the model its owner chose in the app (models.txt of the OS
# release); the MowBite Updater writes both at the switch to MowBite OS and keeps them across updates.
MOWBITE_PLATFORM=
MOWBITE_MODEL=
# Tron only: address the phone reaches the mower at, for the WebSocket of the app.
MOWER_HOST=
# The datum of the garden (WGS84), kept out of the repo.
MOWBITE_DATUM_LAT=
MOWBITE_DATUM_LONG=
MOWBITE_DATUM_HEIGHT=
# Local time for the heartbeat of the MCU and for schedules.
TZ=Europe/Berlin
# NX60i only: where data_dir lives on the CM4, outside of the stack folder so that removing the stack keeps it.
MOWBITE_DATA_DIR=/home/openmower/mowbite-os/data
# NX60i only: the journal of the cores, not inside MOWBITE_DATA_DIR (at most 64 MB and 64 MB of incidents, its
# platform.yaml); empty or missing: /var/lib/mowbite-journal.
MOWBITE_JOURNAL_DIR=/home/openmower/mowbite-os/journal
# NX60i only: OpenMower's folders with map.json and mower_params.yaml (its /data/ros and /data/params), read once on
# the first start of the OS with an empty data_dir; empty or missing: these.
MOWBITE_IMPORT_ROS=/home/openmower/ros
MOWBITE_IMPORT_PARAMS=/home/openmower/params
