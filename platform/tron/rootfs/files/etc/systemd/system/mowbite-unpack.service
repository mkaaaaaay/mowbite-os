[Unit]
Description=Pack of this Tron from the installer, system parts on the first boot
# Kernel modules and firmware come from the pack: before module loading, udev and the hardware setup.
DefaultDependencies=no
ConditionPathExists=/var/lib/mowbite/pack
After=systemd-remount-fs.service
Before=sysinit.target systemd-modules-load.service systemd-udevd.service systemd-udev-trigger.service
Before=mowbite-tron-hwinit.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/mowbite/unpack system

[Install]
WantedBy=sysinit.target
