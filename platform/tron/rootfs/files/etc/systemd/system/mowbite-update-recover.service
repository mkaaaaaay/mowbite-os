[Unit]
Description=MowBite OS, planner and app back to their installation before an unfinished update
ConditionPathExists=|/opt/mowbite/pending
ConditionPathExists=|/opt/mowbite-planner/pending
ConditionPathExists=|/opt/mowbite-app/pending
Before=mowbite-os.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/mowbite-update recover

[Install]
WantedBy=multi-user.target
