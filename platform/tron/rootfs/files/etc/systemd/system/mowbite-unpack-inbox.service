[Unit]
Description=Pack of this Tron from the installer, bundles for /userdata and clearing the pack
ConditionPathExists=/var/lib/mowbite/pack
RequiresMountsFor=/userdata /var/lib/mowbite
After=mowbite-unpack.service
Before=NetworkManager.service ssh.service avahi-daemon.service mowbite-host.service mowbite-os.service

[Service]
Type=oneshot
ExecStart=/usr/lib/mowbite/unpack all

[Install]
WantedBy=multi-user.target
