[Unit]
Description=MowBite crash record of the last boot
DefaultDependencies=no
After=local-fs.target systemd-pstore.service systemd-sysctl.service
Before=sysinit.target

[Service]
Type=oneshot
# Stays active, so a later start job in the same boot does not run it again.
RemainAfterExit=yes
ExecStart=/usr/lib/mowbite/crash

[Install]
WantedBy=sysinit.target
