#!/usr/bin/env python3
"""Switches on the exposure control inside the XC9080 for both SC132 of the stereo camera, over i2c-8 (2 byte register,
1 byte value). Fixed sequence, every write read back: page 80/50, 004d = 3, the largest exposure on page 80/14
(00e2/e3 and 0a96/97 = 53 00, only where both read 20 00, then 0050 = 1 and 0a04 = 1), page 80/50, 004d = 1, SC132
3e03 = 2b, 004d = 2, SC132 3e03 = 2b, then 004d = 0 and page 80/26 in any case. Run by tron-hwinit while nothing
streams. A limit that is not as expected or does not read back stays as it is; the control goes on anyway.

Exit 0: control on. 1: stopped at a value that did not read back, 004d and page set back, the exposure stays fixed.
2: 004d or page could not be set back, the state of the bridge is unknown.
"""
import ctypes
import os
import sys

BUS = "/dev/i2c-8"
XC9080, SC132 = 0x1B, 0x30
# Largest exposure of the control, register pairs on page 80/14 in lines << 4: 1328 lines (28.6 ms, below the frame
# time) instead of the 512 of the bridge table, which leave the picture nearly black at night.
EXPOSURE_LIMIT = (0x00E2, 0x0A96)
EXPOSURE_TABLE, EXPOSURE_WANTED = (0x20, 0x00), (0x53, 0x00)
LIMIT_TAKE_OVER = (0x0050, 0x0A04)
I2C_RDWR, I2C_M_RD = 0x0707, 0x0001


class Msg(ctypes.Structure):
    _fields_ = [("addr", ctypes.c_uint16), ("flags", ctypes.c_uint16), ("len", ctypes.c_uint16),
                ("buf", ctypes.c_void_p)]


class RdWr(ctypes.Structure):
    _fields_ = [("msgs", ctypes.POINTER(Msg)), ("nmsgs", ctypes.c_uint32)]


libc = ctypes.CDLL(None, use_errno=True)
libc.ioctl.argtypes = [ctypes.c_int, ctypes.c_ulong, ctypes.c_void_p]


def transfer(fd, msgs):
    arr = (Msg * len(msgs))(*msgs)
    data = RdWr(arr, len(msgs))
    if libc.ioctl(fd, I2C_RDWR, ctypes.addressof(data)) < 0:
        e = ctypes.get_errno()
        raise OSError(e, os.strerror(e))


def read(fd, addr, reg):
    out = ctypes.create_string_buffer(bytes([reg >> 8, reg & 0xFF]), 2)
    into = ctypes.create_string_buffer(1)
    transfer(fd, [Msg(addr, 0, 2, ctypes.addressof(out)), Msg(addr, I2C_M_RD, 1, ctypes.addressof(into))])
    return into.raw[0]


def put(fd, addr, reg, value):
    out = ctypes.create_string_buffer(bytes([reg >> 8, reg & 0xFF, value]), 3)
    transfer(fd, [Msg(addr, 0, 3, ctypes.addressof(out))])


def write(fd, addr, reg, value, name):
    try:
        put(fd, addr, reg, value)
        back = read(fd, addr, reg)
    except OSError as e:
        print(f"tron-stereo-ae: {name} {reg:04x} = {value:02x}: {e}", flush=True)
        return False
    if back != value:
        print(f"tron-stereo-ae: {name} {reg:04x} = {value:02x}, read back {back:02x}", flush=True)
    return back == value


def exposure_limit(fd, xc):
    """Raises the largest exposure where both pairs still hold the bridge table; the page is 80/50 before and after."""
    if not (xc(0x004D, 0x03) and xc(0xFFFD, 0x80) and xc(0xFFFE, 0x14)):
        return False
    pairs = lambda: [(read(fd, XC9080, reg), read(fd, XC9080, reg + 1)) for reg in EXPOSURE_LIMIT]
    try:
        now = pairs()
        if all(pair == EXPOSURE_WANTED for pair in now):
            print("tron-stereo-ae: exposure limit already raised", flush=True)
        elif any(pair != EXPOSURE_TABLE for pair in now):
            print("tron-stereo-ae: exposure limit left at " + ", ".join(f"{hi:02x} {lo:02x}" for hi, lo in now),
                  flush=True)
        elif all(xc(reg, EXPOSURE_WANTED[0]) and xc(reg + 1, EXPOSURE_WANTED[1]) for reg in EXPOSURE_LIMIT):
            for reg in LIMIT_TAKE_OVER:
                # A take-over flag may clear itself: written, not read back.
                put(fd, XC9080, reg, 0x01)
            kept = all(pair == EXPOSURE_WANTED for pair in pairs())
            print("tron-stereo-ae: exposure limit " + ("raised" if kept else "changed with the take-over"), flush=True)
        else:
            print("tron-stereo-ae: exposure limit not raised, no take-over", flush=True)
    except OSError as e:
        print(f"tron-stereo-ae: exposure limit: {e}", flush=True)
    return xc(0xFFFD, 0x80) and xc(0xFFFE, 0x50)


def control_on(fd):
    xc = lambda reg, v: write(fd, XC9080, reg, v, "XC9080")
    ok = False
    try:
        if not (xc(0xFFFD, 0x80) and xc(0xFFFE, 0x50) and exposure_limit(fd, xc)):
            return 1
        for sensor in (1, 2):
            if not (xc(0x004D, sensor) and write(fd, SC132, 0x3E03, 0x2B, f"SC132 #{sensor}")):
                return 1
        ok = True
        return 0
    finally:
        # 004d lives on page 80/50; back to 0 there, then the page the kernel driver left (80/26).
        back = xc(0xFFFD, 0x80) and xc(0xFFFE, 0x50) and xc(0x004D, 0x00)
        back = xc(0xFFFD, 0x80) and xc(0xFFFE, 0x26) and back
        if not back:
            print("tron-stereo-ae: 004d or page not set back", flush=True)
            sys.exit(2)
        print("tron-stereo-ae: " + ("exposure control on" if ok else "exposure stays fixed"), flush=True)


def main():
    fd = os.open(BUS, os.O_RDWR | os.O_CLOEXEC)
    try:
        sys.exit(control_on(fd))
    finally:
        os.close(fd)


if __name__ == "__main__":
    main()
