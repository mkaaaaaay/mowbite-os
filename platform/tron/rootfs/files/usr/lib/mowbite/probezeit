#!/bin/sh
# Trial period of a newly written rootfs, active while /etc/mowbite/probezeit exists: after MAX_BOOTS boots or
# TIMEOUT without an SSH login the mower reboots into the loader mode of U-Boot, where the PC writes the old rootfs back.
#   probezeit boot      early in every boot: count the boot
#   probezeit ssh       from /etc/ssh/sshrc: confirm this boot
#   probezeit hold      while the first installation runs: no fallback, the boot counter stays; turns into "again"
#                       unless called again within HOLD, so a dead caller cannot hold the boot for good
#   probezeit again     the first installation ended without a running OS: fall back after AGAIN without a login
# After an SSH login in this boot, hold and again do nothing.
#   probezeit timeout   from mowbite-probezeit-check.timer: no login since the boot
#   probezeit end       the owner ends the trial period (mowbite-probezeit-ende)
set -eu
MARK=/etc/mowbite/probezeit
COUNT=/var/lib/mowbite/bootcount
SEEN=/run/mowbite/ssh-seen
LOGIN=/run/mowbite/ssh-login
MAX_BOOTS=3
HOLD=30min
AGAIN=10min

write_count() {
    mkdir -p "${COUNT%/*}"
    echo "$1" > "$COUNT.new"
    sync "$COUNT.new"
    mv "$COUNT.new" "$COUNT"
    sync "${COUNT%/*}"
}

# Stops a pending transient timer; with "all" also its service. The hold service runs "again" and must not stop itself.
stop_unit() {
    set -- "$1.timer" ${2:+"$1.service"}
    systemctl stop "$@" 2>/dev/null || true
    systemctl reset-failed "$@" 2>/dev/null || true
}

# One transient timer per name: a new call replaces the pending one.
later() {
    stop_unit "$1" all
    systemd-run --quiet --unit="$1" --on-active="$2" --timer-property=AccuracySec=10s /usr/lib/mowbite/probezeit "$3"
}

to_loader() {
    echo "probezeit: $1, reboot into the loader"
    # Only the Rockchip U-Boot knows the loader mode; elsewhere (QEMU) the same call runs as a dry run.
    dry=--dry-run
    if grep -qs 'rockchip,rk3588' /proc/device-tree/compatible; then
        dry=
    else
        echo "probezeit: no Rockchip board, dry run only"
    fi
    systemctl $dry --no-block --reboot-argument=loader reboot
}

if [ "${1:-}" != end ] && [ ! -e "$MARK" ]; then
    exit 0
fi

case "${1:-}" in
boot)
    n=$(cat "$COUNT" 2>/dev/null || true)
    case "$n" in ''|*[!0-9]*) n=0 ;; esac
    n=$((n + 1))
    write_count "$n"
    echo "probezeit: boot $n of $MAX_BOOTS without a confirmed login"
    if [ "$n" -ge "$MAX_BOOTS" ]; then
        to_loader "boot $n without a confirmed login"
    fi
    ;;
ssh)
    mkdir -p "${SEEN%/*}"
    touch "$SEEN" "$LOGIN"
    write_count 0
    stop_unit mowbite-probezeit-hold all
    stop_unit mowbite-probezeit-again all
    ;;
hold)
    [ ! -e "$LOGIN" ] || exit 0
    mkdir -p "${SEEN%/*}"
    touch "$SEEN"
    later mowbite-probezeit-hold "$HOLD" again
    ;;
again)
    [ ! -e "$LOGIN" ] || exit 0
    stop_unit mowbite-probezeit-hold
    rm -f "$SEEN"
    later mowbite-probezeit-again "$AGAIN" timeout
    echo "probezeit: no confirmed start, back to the loader in $AGAIN without a login"
    ;;
timeout)
    if [ ! -e "$SEEN" ]; then
        to_loader "no SSH login since the boot"
    fi
    ;;
end)
    stop_unit mowbite-probezeit-hold all
    stop_unit mowbite-probezeit-again all
    rm -f "$MARK" "$COUNT" "$SEEN" "$LOGIN"
    sync
    echo "trial period ended, the mower no longer reboots into the loader on its own"
    ;;
*)
    echo "usage: probezeit boot|ssh|hold|again|timeout|end" >&2
    exit 2
    ;;
esac
