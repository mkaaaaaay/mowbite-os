#!/usr/bin/python3
"""mowbite-update: updates of MowBite OS, its planner, its app and mowbite-host by hand (SSH) and at boot; usage in
mowbite_host.cli. mowbite_boot chooses the library that is confirmed (an installed one or the seed in the rootfs).
"""
import os
import sys

sys.path.insert(0, os.environ.get("MOWBITE_BOOT_LIB", "/usr/lib/mowbite-boot"))
import mowbite_boot  # noqa: E402

mowbite_boot.load(service=False)
from mowbite_host import cli  # noqa: E402

if __name__ == "__main__":
    sys.exit(cli.main(sys.argv))
