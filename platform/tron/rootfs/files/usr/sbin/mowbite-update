#!/usr/bin/python3
"""Installs a signed bundle of MowBite OS by hand (SSH), with the same checks as mowbite-host.

  mowbite-update install <bundle.tar.gz> [<signature>]   (signature default <bundle>.sig)
  mowbite-update rollback                                 back to /opt/mowbite/previous
  mowbite-update recover                                  after an update that did not finish (at boot)
  mowbite-update status

A bundle is a tar of one directory <revision>/ with bundle.json (format 2: component os, revision, serial, base,
min_app, runtime_packages) beside install/, planner/ and tools/. Before the switch: signature (namespace mowbite-os,
/etc/mowbite/allowed_signers), a serial newer than the running one, the base and runtime packages of this rootfs,
every library found (checked as the user mowbite). The switch only while the OS is stopped, or idles on the charging
contacts without an emergency and holds for the update (system.hold over the broker of the OS, the gate reads the
files). After it the OS has to come up healthy, else it goes back; without the broker its files alone decide.
"""
import fcntl
import os
import shutil
import sys
import time

sys.path.insert(0, os.environ.get("MOWBITE_HOST_LIB", "/usr/lib/mowbite-host"))
from mowbite_host import Refused, bundle, carrier, installer, origin, paths, probe, updater  # noqa: E402

# How long install and rollback wait for the broker before they go on without one; 0: never asked.
BROKER_WAIT = float(os.environ.get("MOWBITE_UPDATE_BROKER_WAIT", 5.0))


class NoBroker:
    """Without the broker the OS cannot be asked for its hold: only a stopped OS switches."""

    def request_hold(self, seconds):
        pass

    def release_hold(self):
        pass


# The broker of the OS for system.hold and the health check as mowbite-host does them; None when it does not answer.
def connect(where):
    if BROKER_WAIT <= 0:
        return None, None
    from mowbite_host import broker
    env = where.env()
    check = None

    def route(message):
        if message.topic == client.answers:
            rpc.on_answer(message.payload)
        elif message.topic == "robot_state/json":
            check.on_robot_state(message.payload)
    client = broker.Broker(env.get("MOWBITE_MQTT_HOST") or "127.0.0.1", env.get("MOWBITE_MQTT_PORT") or 1883,
                           "mowbite-update", [("robot_state/json", 0)], on_message=route)
    rpc = probe.OsRpc(client)
    check = probe.Probe(rpc)
    client.start()
    deadline = time.monotonic() + BROKER_WAIT
    while not client.connected and time.monotonic() < deadline:
        time.sleep(0.1)
    if not client.connected:
        client.stop()
        return None, None
    return rpc, check


def make(prefix, with_broker):
    where = paths.Paths(prefix)
    service = carrier.Systemd()
    rpc, check = connect(where) if with_broker else (None, None)
    if with_broker and rpc is None:
        print("no broker: only a stopped OS switches, its health is judged from its files", file=sys.stderr)
    health = installer.Health(where, service, check, wait=float(os.environ.get("MOWBITE_UPDATE_HEALTH_WAIT",
                                                                                installer.HEALTH_WAIT)))
    tool = updater.Updater(where, service, health, origin.Inbox(where), rpc or NoBroker())
    if check is not None:
        check.api_of_running = lambda: (tool.installer.meta_of(tool.installer.current()) or {}).get("api")
    # By hand the gate is judged once, there is no waiting for it.
    tool.gate_wait = 0
    return tool


# The candidate of a bundle given by path: read once here, read again from its own copy by the install.
def candidate_of(tool, path, signature):
    folder = os.path.join(tool.paths.stage, "cli")
    try:
        staged = bundle.stage(path, signature, "os", folder, tool.paths.signers)
    finally:
        shutil.rmtree(folder, ignore_errors=True)
    return {"component": "os", "revision": staged.revision, "serial": staged.serial, "path": path, "sig": signature}


def wait_and_report(tool):
    last = tool.join() or {}
    print(f"{last.get('result')}: {last.get('reason') or ''} {last.get('message', '')}".strip(), flush=True)
    return last.get("result") == "installed"


def main(argv):
    prefix = os.environ.get("MOWBITE_UPDATE_PREFIX", "")
    if len(argv) in (3, 4) and argv[1] == "install":
        signature = argv[3] if len(argv) == 4 else argv[2] + ".sig"
    elif argv[1:] not in (["rollback"], ["recover"], ["status"]):
        print(__doc__, file=sys.stderr)
        return 2
    tool = make(prefix, argv[1] in ("install", "rollback"))
    if argv[1] == "status":
        print("\n".join(tool.installer.status_lines()))
        return 0
    os.makedirs(tool.paths.opt, exist_ok=True)
    os.makedirs(os.path.dirname(tool.paths.lock), exist_ok=True)
    with open(tool.paths.lock, "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("mowbite-host or another mowbite-update runs: stop mowbite-host or update over the app",
                  file=sys.stderr)
            return 1
        try:
            if argv[1] == "recover":
                tool.recover()
                return 0
            if argv[1] == "rollback":
                tool.rollback("os")
            else:
                candidate = candidate_of(tool, argv[2], signature)
                tool.offer(candidate)
                tool.start("os", candidate["revision"])
            return 0 if wait_and_report(tool) else 1
        except Refused as why:
            print(f"refused: {why.reason}: {why}", file=sys.stderr)
            return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
