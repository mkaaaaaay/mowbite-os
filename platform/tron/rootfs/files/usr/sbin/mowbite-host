#!/usr/bin/python3
"""mowbite-host (mowbite-host.service): updates of MowBite OS, its planner, its app and of itself, beside the OS as
root. mowbite_boot chooses its library (an installed one or the seed in the rootfs); the program is mowbite_host.main.
"""
import os
import sys

sys.path.insert(0, os.environ.get("MOWBITE_BOOT_LIB", "/usr/lib/mowbite-boot"))
import mowbite_boot  # noqa: E402

mowbite_boot.load(service=True)
from mowbite_host import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main.run())
